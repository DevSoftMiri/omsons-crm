generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  VISIT
  TASK
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  name              String
  phone             String?
  refreshTokenHash  String?
  isActive          Boolean    @default(true)
  roles             UserRole[]
  assignedLeads     Lead[]     @relation("LeadOwner")
  ownedDeals        Deal[]     @relation("DealOwner")
  ownedCompanies    Company[]  @relation("CompanyOwner")
  ownedContacts     Contact[]  @relation("ContactOwner")
  activities        Activity[]
  notes             Note[]
  tasks             Task[]
  followUps         FollowUp[]
  visits            Visit[]
  auditLogs         AuditLog[] @relation("AuditActor")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  action      String
  subject     String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([action, subject])
  @@index([subject])
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@id([roleId, permissionId])
}

model Company {
  id              String    @id @default(cuid())
  name            String
  industry        String?
  website         String?
  phone           String?
  city            String?
  state           String?
  country         String    @default("India")
  regions         String[]  @default([])
  parentCompanyId String?
  ownerId         String?
  owner           User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isArchived      Boolean   @default(false)
  parentCompany   Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  subCompanies    Company[] @relation("CompanyHierarchy")
  contacts        Contact[]
  leads           Lead[]
  deals           Deal[]
  dealers         Dealer[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([name])
  @@index([city, state])
  @@index([parentCompanyId])
  @@index([ownerId])
  @@index([isArchived])
}

model Contact {
  id        String     @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  title     String?
  ownerId   String?
  owner     User?      @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lifecycleStage String?
  leadStatus String?
  companyId String?
  company   Company?   @relation(fields: [companyId], references: [id])
  leads     Lead[]
  deals     Deal[]
  activities Activity[]
  notes     Note[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([email])
  @@index([phone])
  @@index([firstName, lastName])
  @@index([ownerId])
  @@index([lifecycleStage])
  @@index([leadStatus])
}

model Dealer {
  id        String    @id @default(cuid())
  code      String?   @unique
  name      String
  region    String?
  city      String?
  state     String?
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  leads     Lead[]
  visits    Visit[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([region])
}

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  order     Int
  color     String?
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Lead {
  id              String         @id @default(cuid())
  title           String
  status          LeadStatus     @default(NEW)
  priority        Priority       @default(MEDIUM)
  value           Decimal?       @db.Decimal(12, 2)
  source          String?
  expectedCloseAt DateTime?
  ownerId         String?
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id])
  companyId       String?
  company         Company?       @relation(fields: [companyId], references: [id])
  contactId       String?
  contact         Contact?       @relation(fields: [contactId], references: [id])
  dealerId        String?
  dealer          Dealer?        @relation(fields: [dealerId], references: [id])
  stageId         String?
  stage           PipelineStage? @relation(fields: [stageId], references: [id])
  activities      Activity[]
  notes           Note[]
  tasks           Task[]
  followUps       FollowUp[]
  files           FileAsset[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([priority])
  @@index([ownerId])
  @@index([expectedCloseAt])
  @@index([createdAt])
}

model Deal {
  id              String    @id @default(cuid())
  name            String
  pipeline        String    @default("Sales Pipeline")
  stage           String    @default("Appointment Scheduled")
  amount          Decimal?  @db.Decimal(12, 2)
  closeDate       DateTime?
  dealType        String?
  priority        Priority  @default(MEDIUM)
  ownerId         String?
  owner           User?     @relation("DealOwner", fields: [ownerId], references: [id])
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id])
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  lineItems       Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([pipeline, stage])
  @@index([ownerId])
  @@index([closeDate])
  @@index([createdAt])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  subject   String
  body      String?
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id])
  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id])
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type])
  @@index([createdAt])
}

model Note {
  id        String   @id @default(cuid())
  body      String
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id        String    @id @default(cuid())
  title     String
  dueAt     DateTime?
  priority  Priority  @default(MEDIUM)
  doneAt    DateTime?
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id])
  assigneeId String?
  assignee  User?     @relation(fields: [assigneeId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([dueAt])
  @@index([doneAt])
}

model FollowUp {
  id        String    @id @default(cuid())
  title     String
  dueAt     DateTime
  completedAt DateTime?
  leadId    String?
  lead      Lead?     @relation(fields: [leadId], references: [id])
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([dueAt])
  @@index([completedAt])
}

model Visit {
  id        String   @id @default(cuid())
  purpose   String
  visitedAt DateTime
  location  String?
  dealerId  String?
  dealer    Dealer?  @relation(fields: [dealerId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitedAt])
}

model Report {
  id        String   @id @default(cuid())
  name      String
  type      String
  filters   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FileAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  url       String
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Integration {
  id        String   @id @default(cuid())
  provider  String
  status    String
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
