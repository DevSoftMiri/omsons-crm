generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  name             String
  phone            String?
  refreshTokenHash String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  activities       Activity[]
  meetings         Meeting[]
  auditLogs        AuditLog[] @relation("AuditActor")
  ownedCompanies   Company[]  @relation("CompanyOwner")
  ownedContacts    Contact[]  @relation("ContactOwner")
  ownedDeals       Deal[]     @relation("DealOwner")
  followUps        FollowUp[]
  assignedLeads    Lead[]     @relation("LeadOwner")
  notes            Note[]
  createdSegments  Segment[]  @relation("SegmentCreator")
  tasks            Task[]
  roles            UserRole[]
  visits           Visit[]

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  action      String
  subject     String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([action, subject])
  @@index([subject])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Company {
  id                         String    @id @default(cuid())
  name                       String
  industry                   String?
  website                    String?
  city                       String?
  state                      String?
  country                    String    @default("India")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  regions                    String[]  @default([])
  parentCompanyId            String?
  ownerId                    String?
  ownerName                  String?
  lifecycleStage             String    @default("Subscriber")
  isArchived                 Boolean   @default(false)
  phone                      String?
  annualRevenue              Decimal?  @db.Decimal(14, 2)
  companySize                String?
  customerSince              DateTime?
  customerType               String?
  targetAccount              Boolean   @default(false)
  idealCustomerProfileTier   String?
  numberOfBlockers           Int       @default(0)
  numberOfBuyingRoleContacts Int       @default(0)
  numberOfDecisionMakers     Int       @default(0)
  customFields               Json      @default("{}")
  domainName                 String?
  postalCode                 String?
  numberOfEmployees          Int?
  timeZone                   String?
  description                String?
  linkedinCompanyPage        String?
  owner                      User?     @relation("CompanyOwner", fields: [ownerId], references: [id])
  parentCompany              Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  subCompanies               Company[] @relation("CompanyHierarchy")
  contacts                   Contact[]
  deals                      Deal[]
  dealers                    Dealer[]
  leads                      Lead[]
  meetings                   Meeting[]
  notes                      Note[]
  followUps                  FollowUp[]

  @@index([name])
  @@index([city, state])
  @@index([parentCompanyId])
  @@index([ownerId])
  @@index([isArchived])
  @@index([customerType])
  @@index([companySize])
  @@index([customerSince])
  @@index([lifecycleStage])
}

model Contact {
  id              String     @id @default(cuid())
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  title           String?
  companyId       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  ownerId         String?
  lifecycleStage  String?
  leadStatus      String?
  contactSource   String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  department      String?
  roleInPurchase  String?
  activities      Activity[]
  company         Company?   @relation(fields: [companyId], references: [id])
  owner           User?      @relation("ContactOwner", fields: [ownerId], references: [id])
  deals           Deal[]
  leads           Lead[]
  notes           Note[]
  meetings        Meeting[]

  @@index([email])
  @@index([phone])
  @@index([firstName, lastName])
  @@index([ownerId])
  @@index([lifecycleStage])
  @@index([leadStatus])
  @@index([lastContactedAt])
  @@index([nextFollowUpAt])
  @@index([contactSource])
}

model Dealer {
  id        String   @id @default(cuid())
  code      String?  @unique
  name      String
  region    String?
  city      String?
  state     String?
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  leads     Lead[]
  visits    Visit[]

  @@index([name])
  @@index([region])
}

model PipelineStage {
  id          String    @id @default(cuid())
  name        String
  order       Int
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  pipelineId  String?
  description String?
  probability Int?
  deals       Deal[]    @relation("DealStageRecord")
  leads       Lead[]
  pipeline    Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, name])
  @@index([pipelineId, order])
  @@index([order])
}

model Pipeline {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deals     Deal[]          @relation("DealPipelineRecord")
  stages    PipelineStage[]
}

model Lead {
  id              String         @id @default(cuid())
  title           String
  status          LeadStatus     @default(NEW)
  priority        Priority       @default(MEDIUM)
  value           Decimal?       @db.Decimal(12, 2)
  source          String?
  expectedCloseAt DateTime?
  ownerId         String?
  companyId       String?
  contactId       String?
  dealerId        String?
  stageId         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  activities      Activity[]
  files           FileAsset[]
  followUps       FollowUp[]
  company         Company?       @relation(fields: [companyId], references: [id])
  contact         Contact?       @relation(fields: [contactId], references: [id])
  dealer          Dealer?        @relation(fields: [dealerId], references: [id])
  owner           User?          @relation("LeadOwner", fields: [ownerId], references: [id])
  stage           PipelineStage? @relation(fields: [stageId], references: [id])
  notes           Note[]
  tasks           Task[]

  @@index([status])
  @@index([priority])
  @@index([ownerId])
  @@index([expectedCloseAt])
  @@index([createdAt])
}

model Deal {
  id                String         @id @default(cuid())
  name              String
  pipeline          String         @default("Sales Pipeline")
  stage             String         @default("Appointment Scheduled")
  amount            Decimal?       @db.Decimal(12, 2)
  closeDate         DateTime?
  dealType          String?
  priority          Priority       @default(MEDIUM)
  ownerId           String?
  contactId         String?
  companyId         String?
  lineItems         Json           @default("[]")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  expectedCloseDate DateTime?
  lastActivityAt    DateTime?
  probability       Int?
  productCategory   String?
  stageChangedAt    DateTime?
  pipelineId        String?
  stageId           String?
  company           Company?       @relation(fields: [companyId], references: [id])
  contact           Contact?       @relation(fields: [contactId], references: [id])
  owner             User?          @relation("DealOwner", fields: [ownerId], references: [id])
  pipelineRecord    Pipeline?      @relation("DealPipelineRecord", fields: [pipelineId], references: [id])
  stageRecord       PipelineStage? @relation("DealStageRecord", fields: [stageId], references: [id])
  meetings          Meeting[]

  @@index([pipeline, stage])
  @@index([pipelineId, stageId])
  @@index([ownerId])
  @@index([closeDate])
  @@index([createdAt])
  @@index([probability])
  @@index([expectedCloseDate])
  @@index([productCategory])
  @@index([stageChangedAt])
  @@index([lastActivityAt])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  subject   String
  body      String?
  leadId    String?
  contactId String?
  userId    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  contact   Contact?     @relation(fields: [contactId], references: [id])
  lead      Lead?        @relation(fields: [leadId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([createdAt])
}

model Meeting {
  id          String   @id @default(cuid())
  name        String
  activityAt  DateTime
  ownerId     String?
  type        String?
  outcome     String?
  location    String?
  contactId   String?
  dealId      String?
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User?    @relation(fields: [ownerId], references: [id])
  contact     Contact? @relation(fields: [contactId], references: [id])
  deal        Deal?    @relation(fields: [dealId], references: [id])
  company     Company? @relation(fields: [companyId], references: [id])

  @@index([activityAt])
  @@index([ownerId])
  @@index([type])
  @@index([outcome])
  @@index([contactId])
  @@index([dealId])
  @@index([companyId])
}

model Note {
  id        String   @id @default(cuid())
  title     String?
  body      String
  companyId String?
  leadId    String?
  contactId String?
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User?    @relation(fields: [authorId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])
  contact   Contact? @relation(fields: [contactId], references: [id])
  links     NoteActivity[]
  followUps FollowUp[]
  lead      Lead?    @relation(fields: [leadId], references: [id])
}

model NoteActivity {
  id         String   @id @default(cuid())
  noteId     String
  activityId String
  kind       String
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([noteId, activityId, kind])
  @@index([activityId, kind])
}

model Task {
  id         String    @id @default(cuid())
  title      String
  dueAt      DateTime?
  priority   Priority  @default(MEDIUM)
  doneAt     DateTime?
  leadId     String?
  assigneeId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  assignee   User?     @relation(fields: [assigneeId], references: [id])
  lead       Lead?     @relation(fields: [leadId], references: [id])

  @@index([dueAt])
  @@index([doneAt])
}

model FollowUp {
  id          String    @id @default(cuid())
  title       String
  dueAt       DateTime
  completedAt DateTime?
  leadId      String?
  ownerId     String?
  companyId   String?
  noteId      String?
  type        String    @default("TASK")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lead        Lead?     @relation(fields: [leadId], references: [id])
  owner       User?     @relation(fields: [ownerId], references: [id])
  company     Company?  @relation(fields: [companyId], references: [id])
  note        Note?     @relation(fields: [noteId], references: [id])

  @@index([dueAt])
  @@index([completedAt])
}

model Visit {
  id        String   @id @default(cuid())
  purpose   String
  visitedAt DateTime
  location  String?
  dealerId  String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dealer    Dealer?  @relation(fields: [dealerId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([visitedAt])
}

model Report {
  id        String   @id @default(cuid())
  name      String
  type      String
  filters   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Segment {
  id          String        @id @default(cuid())
  name        String
  description String?
  objectType  SegmentObject
  filters     Json          @default("{}")
  isDeleted   Boolean       @default(false)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation("SegmentCreator", fields: [createdById], references: [id])

  @@index([objectType])
  @@index([isDeleted])
  @@index([createdById])
  @@index([updatedAt])
}

model FileAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  url       String
  leadId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead?    @relation(fields: [leadId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Integration {
  id        String   @id @default(cuid())
  provider  String
  status    String
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  status    Int
  response  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique
  slug            String           @unique
  name            String
  category        String?
  categories      Json             @default("[]")
  page            Int?
  features        Json             @default("[]")
  descriptionHtml String?
  images          Json             @default("[]")
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  variants        ProductVariant[]

  @@index([name])
  @@index([category])
  @@index([isArchived])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique
  name       String
  slug       String?
  specs      Json     @default("{}")
  specsText  String?
  pack       Int?
  price      Decimal? @db.Decimal(14, 2)
  priceLabel String?
  priceBasis String?
  inStock    Boolean  @default(false)
  images     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([inStock])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  VISIT
  TASK
}

enum SegmentObject {
  COMPANY
  CONTACT
  DEAL
}
